<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.example</groupId>
  <artifactId>oceanlink-bom</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>oceanlink-bom</name>
  <url>https://maven.apache.org</url>
  <description>统一版本号</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.version>3.8.1</maven.compiler.version>


    <hutool.version>5.8.21</hutool.version>
    <common-lang3.version>3.11</common-lang3.version>
    <commons-collections4.version>4.4</commons-collections4.version>
    <guava.version>33.2.1-jre</guava.version>
    <money-api.version>1.1</money-api.version>
    <moneta.version>1.4.5</moneta.version>

    <spring-boot.version>2.7.6</spring-boot.version>
    <redisson.version>3.18.0</redisson.version>
    <easyexcel.version>4.0.3</easyexcel.version>
    <fastjson.version>1.2.83</fastjson.version>
    <logstash-logback-encoder.version>7.0.1</logstash-logback-encoder.version>
    <clickhouse.jdbc.version>0.9.0</clickhouse.jdbc.version>
    <dynamic-datasource.version>4.1.3</dynamic-datasource.version>
    <spring-boot-admin.version>2.7.10</spring-boot-admin.version>

    <skywalking.version>9.3.0</skywalking.version>

    <org.projectlombok.version>1.18.30</org.projectlombok.version>
    <org.mapstruct.version>1.5.5.Final</org.mapstruct.version>

    <oceanlink.api.version>1.0.0-SNAPSHOT</oceanlink.api.version>
    <oceanlink.common.version>1.0.0-SNAPSHOT</oceanlink.common.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.example</groupId>
        <artifactId>oceanlink-api</artifactId>
        <version>${oceanlink.api.version}</version>
      </dependency>
      <dependency>
        <groupId>de.codecentric</groupId>
        <artifactId>spring-boot-admin-starter-client</artifactId>
        <version>${spring-boot-admin.version}</version>
      </dependency>
      <!-- clickhouse jdbc -->
      <dependency>
        <groupId>com.clickhouse</groupId>
        <artifactId>clickhouse-jdbc</artifactId>
        <version>${clickhouse.jdbc.version}</version>
        <classifier>all</classifier>
      </dependency>
      <dependency>
        <groupId>org.example</groupId>
        <artifactId>oceanlink-common</artifactId>
        <version>${oceanlink.common.version}</version>
      </dependency>

      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>dynamic-datasource-spring-boot-starter</artifactId>
        <version>${dynamic-datasource.version}</version>
      </dependency>
      <!-- common -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>${common-lang3.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-collections4</artifactId>
        <version>${commons-collections4.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.hutool</groupId>
        <artifactId>hutool-all</artifactId>
        <version>${hutool.version}</version>
      </dependency>
      <dependency>
        <groupId>com.alibaba</groupId>
        <artifactId>fastjson</artifactId>
        <version>${fastjson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.alibaba</groupId>
        <artifactId>easyexcel</artifactId>
        <version>${easyexcel.version}</version>
      </dependency>
      <!-- JSR 354 API -->
      <dependency>
        <groupId>javax.money</groupId>
        <artifactId>money-api</artifactId>
        <version>${money-api.version}</version>
      </dependency>
      <!-- JSR 354 参考实现 (Moneta) -->
      <dependency>
        <groupId>org.javamoney</groupId>
        <artifactId>moneta</artifactId>
        <version>${moneta.version}</version>
        <scope>runtime</scope> <!-- 通常是运行时依赖 -->
      </dependency>
      <dependency>
        <groupId>net.logstash.logback</groupId>
        <artifactId>logstash-logback-encoder</artifactId>
        <version>${logstash-logback-encoder.version}</version>
      </dependency>
      <!-- 引入 skywalking 依赖-->
      <dependency>
        <groupId>org.apache.skywalking</groupId>
        <artifactId>apm-toolkit-logback-1.x</artifactId>
        <version>${skywalking.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.skywalking</groupId>
        <artifactId>apm-toolkit-trace</artifactId>
        <version>${skywalking.version}</version>
      </dependency>
      <!-- annotation processor -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${org.projectlombok.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${org.mapstruct.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
